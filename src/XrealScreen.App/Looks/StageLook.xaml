<?xml version="1.0" encoding="utf-8" ?>
<!--  Stage look: the window shows what the glasses show. Dark room, glowing screens, one floating dock, icon rail, amber. Dark only.  -->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--  Palette  -->
    <SolidColorBrush x:Key="StageRailBrush" Color="#FF0B0E14" />
    <SolidColorBrush x:Key="StageTextBrush" Color="#FFEEF1F6" />
    <SolidColorBrush x:Key="StageMutedBrush" Color="#FF8E98A8" />
    <SolidColorBrush x:Key="StageLineBrush" Color="#17FFFFFF" />
    <SolidColorBrush x:Key="StageAmberBrush" Color="#FFF4A63E" />
    <SolidColorBrush x:Key="StageScreenBrush" Color="#FFDFE7F4" />
    <SolidColorBrush x:Key="StageChipBrush" Color="#B8181E28" />
    <SolidColorBrush x:Key="StageCardBrush" Color="#FF151A23" />

    <SolidColorBrush x:Key="LookShellBackground" Color="#FF0E1219" />
    <FontFamily x:Key="LookDisplayFontFamily">Segoe UI Variable Display</FontFamily>
    <FontFamily x:Key="LookMonoFontFamily">Cascadia Mono, Consolas</FontFamily>

    <!--  Accent (control templates read these brushes, so the system accent colours are not enough)  -->
    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#FFF4A63E" />
    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#FFF6B55D" />
    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#FFD98E2A" />
    <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#FFF6B55D" />
    <SolidColorBrush x:Key="AccentTextFillColorSecondaryBrush" Color="#FFF6B55D" />
    <SolidColorBrush x:Key="AccentTextFillColorTertiaryBrush" Color="#FFF6B55D" />
    <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#FF1B1408" />
    <SolidColorBrush x:Key="AccentButtonBackground" Color="#FFF4A63E" />
    <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#FFF6B55D" />
    <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#FFD98E2A" />
    <SolidColorBrush x:Key="AccentButtonForeground" Color="#FF1B1408" />
    <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="#FF1B1408" />
    <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="#FF1B1408" />
    <SolidColorBrush x:Key="AccentButtonBorderBrush" Color="#00000000" />
    <SolidColorBrush x:Key="AccentButtonBorderBrushPointerOver" Color="#00000000" />
    <SolidColorBrush x:Key="AccentButtonBorderBrushPressed" Color="#00000000" />
    <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="#FFF4A63E" />
    <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="#FFF6B55D" />
    <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="#FFD98E2A" />
    <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="#FF1B1408" />
    <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPointerOver" Color="#FF1B1408" />
    <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPressed" Color="#FF1B1408" />
    <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedStroke" Color="#FFF4A63E" />
    <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedStrokePointerOver" Color="#FFF6B55D" />
    <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedStrokePressed" Color="#FFD98E2A" />
    <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedFill" Color="#FFF4A63E" />
    <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedFillPointerOver" Color="#FFF6B55D" />
    <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedFillPressed" Color="#FFD98E2A" />
    <SolidColorBrush x:Key="RadioButtonCheckGlyphFill" Color="#FF1B1408" />
    <SolidColorBrush x:Key="RadioButtonCheckGlyphFillPointerOver" Color="#FF1B1408" />
    <SolidColorBrush x:Key="RadioButtonCheckGlyphFillPressed" Color="#FF1B1408" />
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillChecked" Color="#FFF4A63E" />
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPointerOver" Color="#FFF6B55D" />
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPressed" Color="#FFD98E2A" />
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeChecked" Color="#FFF4A63E" />
    <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundChecked" Color="#FF1B1408" />
    <SolidColorBrush x:Key="SliderTrackValueFill" Color="#FFF4A63E" />
    <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="#FFF6B55D" />
    <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="#FFD98E2A" />
    <SolidColorBrush x:Key="SliderThumbBackground" Color="#FFF4A63E" />
    <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="#FFF6B55D" />
    <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="#FFD98E2A" />
    <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="#FFF4A63E" />
    <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="#FFF6B55D" />
    <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="#FFD98E2A" />
    <SolidColorBrush x:Key="ToggleButtonForegroundChecked" Color="#FF1B1408" />
    <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPointerOver" Color="#FF1B1408" />
    <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPressed" Color="#FF1B1408" />
    <SolidColorBrush x:Key="HyperlinkButtonForeground" Color="#FFF6B55D" />
    <SolidColorBrush x:Key="HyperlinkButtonForegroundPointerOver" Color="#FFF6B55D" />
    <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#FFF4A63E" />
    <SolidColorBrush x:Key="ComboBoxItemPillFillBrush" Color="#FFF4A63E" />
    <SolidColorBrush x:Key="ListViewItemSelectionIndicatorBrush" Color="#FFF4A63E" />
    <SolidColorBrush x:Key="ProgressRingForegroundThemeBrush" Color="#FFF4A63E" />
    <SolidColorBrush x:Key="ProgressBarForeground" Color="#FFF4A63E" />

    <!--  Navigation pane  -->
    <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="#FF0B0E14" />
    <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="#FF0B0E14" />
    <SolidColorBrush x:Key="NavigationViewMinimalPaneBackground" Color="#FF0B0E14" />
    <SolidColorBrush x:Key="NavigationViewTopPaneBackground" Color="#FF0B0E14" />
    <SolidColorBrush x:Key="NavigationViewContentBackground" Color="#FF0E1219" />
    <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="#17FFFFFF" />
    <SolidColorBrush x:Key="NavigationViewItemForeground" Color="#FF8E98A8" />
    <SolidColorBrush x:Key="NavigationViewItemForegroundPointerOver" Color="#FFF4A63E" />
    <SolidColorBrush x:Key="NavigationViewItemForegroundSelected" Color="#FFF4A63E" />
    <SolidColorBrush x:Key="NavigationViewItemForegroundSelectedPointerOver" Color="#FFF4A63E" />
    <SolidColorBrush x:Key="NavigationViewItemBackgroundPointerOver" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="NavigationViewItemBackgroundSelected" Color="#24F4A63E" />
    <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPointerOver" Color="#24F4A63E" />
    <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="#FFF4A63E" />

    <LinearGradientBrush x:Key="StageRoomBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#FF111723" />
        <GradientStop Offset="0.62" Color="#FF0C1018" />
        <GradientStop Offset="1" Color="#FF0A0D13" />
    </LinearGradientBrush>
    <RadialGradientBrush x:Key="StageGlowBrush">
        <GradientStop Offset="0" Color="#2EA0BEF0" />
        <GradientStop Offset="1" Color="#00A0BEF0" />
    </RadialGradientBrush>
    <LinearGradientBrush x:Key="StageScreenFaceBrush" StartPoint="0,0" EndPoint="0.3,1">
        <GradientStop Offset="0" Color="#FFF2F5FA" />
        <GradientStop Offset="1" Color="#FFCFD9E8" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="StageFloorFadeBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#FF0C1018" />
        <GradientStop Offset="0.7" Color="#000C1018" />
    </LinearGradientBrush>
    <AcrylicBrush x:Key="StageDockBrush" TintColor="#FF141A24" TintOpacity="0.75" TintLuminosityOpacity="0.4" FallbackColor="#F0141A24" />

    <Style x:Key="CardStyle" TargetType="Border">
        <Setter Property="Background" Value="#FF151A23" />
        <Setter Property="BorderBrush" Value="#17FFFFFF" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Padding" Value="20" />
    </Style>

    <Style x:Key="PageTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
        <Setter Property="FontFamily" Value="Segoe UI Variable Display" />
        <Setter Property="FontSize" Value="34" />
        <Setter Property="FontWeight" Value="Black" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <Style x:Key="SubtitleTextBlockStyle" TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
        <Setter Property="FontFamily" Value="Segoe UI Variable Display" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <Style x:Key="StageDockButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Padding" Value="14,11" />
        <Setter Property="Foreground" Value="#FFEEF1F6" />
    </Style>

    <Style x:Key="StageSegmentStyle" TargetType="ToggleButton" BasedOn="{StaticResource DefaultToggleButtonStyle}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="Foreground" Value="#FF8E98A8" />
    </Style>
</ResourceDictionary>

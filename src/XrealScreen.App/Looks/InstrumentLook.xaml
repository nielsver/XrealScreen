<?xml version="1.0" encoding="utf-8" ?>
<!--  Instrument look: a light calibration tool. Ruled surfaces, condensed labels (Bahnschrift), monospace numbers, signal orange. Light only.  -->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--  Palette  -->
    <SolidColorBrush x:Key="InstSurfaceBrush" Color="#FFF8FAFB" />
    <SolidColorBrush x:Key="InstInkBrush" Color="#FF0F1D2B" />
    <SolidColorBrush x:Key="InstMutedBrush" Color="#FF5A6878" />
    <SolidColorBrush x:Key="InstRuleBrush" Color="#FFC3CCD6" />
    <SolidColorBrush x:Key="InstSignalBrush" Color="#FFF2541B" />
    <SolidColorBrush x:Key="InstBlueBrush" Color="#FF1F4F8F" />
    <SolidColorBrush x:Key="InstGridBrush" Color="#FFDCE2E8" />
    <SolidColorBrush x:Key="InstFieldBrush" Color="#FFFBFCFD" />
    <SolidColorBrush x:Key="InstSelectedBrush" Color="#FFFFF1EA" />

    <SolidColorBrush x:Key="LookShellBackground" Color="#FFE9EDF1" />
    <FontFamily x:Key="LookDisplayFontFamily">Bahnschrift</FontFamily>
    <FontFamily x:Key="LookMonoFontFamily">Cascadia Mono, Consolas</FontFamily>
    <FontFamily x:Key="ContentControlThemeFontFamily">Bahnschrift</FontFamily>

    <!--  Accent (control templates read these brushes, so the system accent colours are not enough)  -->
    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#FFF2541B" />
    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#FFF46A37" />
    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#FFD9440E" />
    <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#FFC8400C" />
    <SolidColorBrush x:Key="AccentTextFillColorSecondaryBrush" Color="#FFC8400C" />
    <SolidColorBrush x:Key="AccentTextFillColorTertiaryBrush" Color="#FFC8400C" />
    <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="AccentButtonBackground" Color="#FFF2541B" />
    <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#FFF46A37" />
    <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#FFD9440E" />
    <SolidColorBrush x:Key="AccentButtonForeground" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="AccentButtonBorderBrush" Color="#00000000" />
    <SolidColorBrush x:Key="AccentButtonBorderBrushPointerOver" Color="#00000000" />
    <SolidColorBrush x:Key="AccentButtonBorderBrushPressed" Color="#00000000" />
    <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="#FFF2541B" />
    <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="#FFF46A37" />
    <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="#FFD9440E" />
    <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPointerOver" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPressed" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedStroke" Color="#FFF2541B" />
    <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedStrokePointerOver" Color="#FFF46A37" />
    <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedStrokePressed" Color="#FFD9440E" />
    <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedFill" Color="#FFF2541B" />
    <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedFillPointerOver" Color="#FFF46A37" />
    <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedFillPressed" Color="#FFD9440E" />
    <SolidColorBrush x:Key="RadioButtonCheckGlyphFill" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="RadioButtonCheckGlyphFillPointerOver" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="RadioButtonCheckGlyphFillPressed" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillChecked" Color="#FFF2541B" />
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPointerOver" Color="#FFF46A37" />
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPressed" Color="#FFD9440E" />
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeChecked" Color="#FFF2541B" />
    <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundChecked" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="SliderTrackValueFill" Color="#FFF2541B" />
    <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="#FFF46A37" />
    <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="#FFD9440E" />
    <SolidColorBrush x:Key="SliderThumbBackground" Color="#FFF2541B" />
    <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="#FFF46A37" />
    <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="#FFD9440E" />
    <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="#FFF2541B" />
    <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="#FFF46A37" />
    <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="#FFD9440E" />
    <SolidColorBrush x:Key="ToggleButtonForegroundChecked" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPointerOver" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPressed" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="HyperlinkButtonForeground" Color="#FFC8400C" />
    <SolidColorBrush x:Key="HyperlinkButtonForegroundPointerOver" Color="#FFC8400C" />
    <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#FFF2541B" />
    <SolidColorBrush x:Key="ComboBoxItemPillFillBrush" Color="#FFF2541B" />
    <SolidColorBrush x:Key="ListViewItemSelectionIndicatorBrush" Color="#FFF2541B" />
    <SolidColorBrush x:Key="ProgressRingForegroundThemeBrush" Color="#FFF2541B" />
    <SolidColorBrush x:Key="ProgressBarForeground" Color="#FFF2541B" />

    <!--  Navigation pane  -->
    <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="#FFF8FAFB" />
    <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="#FFF8FAFB" />
    <SolidColorBrush x:Key="NavigationViewMinimalPaneBackground" Color="#FFF8FAFB" />
    <SolidColorBrush x:Key="NavigationViewTopPaneBackground" Color="#FFF8FAFB" />
    <SolidColorBrush x:Key="NavigationViewContentBackground" Color="#FFE9EDF1" />
    <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="#FFC3CCD6" />
    <SolidColorBrush x:Key="NavigationViewItemForeground" Color="#FF5A6878" />
    <SolidColorBrush x:Key="NavigationViewItemForegroundPointerOver" Color="#FF0F1D2B" />
    <SolidColorBrush x:Key="NavigationViewItemForegroundSelected" Color="#FF0F1D2B" />
    <SolidColorBrush x:Key="NavigationViewItemForegroundSelectedPointerOver" Color="#FF0F1D2B" />
    <SolidColorBrush x:Key="NavigationViewItemBackgroundPointerOver" Color="#FFEEF2F5" />
    <SolidColorBrush x:Key="NavigationViewItemBackgroundSelected" Color="#FFEEF2F5" />
    <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPointerOver" Color="#FFEEF2F5" />
    <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="#FFF2541B" />

    <CornerRadius x:Key="ControlCornerRadius">2</CornerRadius>
    <CornerRadius x:Key="OverlayCornerRadius">3</CornerRadius>

    <Style x:Key="CardStyle" TargetType="Border">
        <Setter Property="Background" Value="#FFF8FAFB" />
        <Setter Property="BorderBrush" Value="#FFC3CCD6" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="Padding" Value="18" />
    </Style>

    <Style x:Key="PageTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
        <Setter Property="FontFamily" Value="Bahnschrift" />
        <Setter Property="FontStretch" Value="Condensed" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="30" />
        <Setter Property="CharacterSpacing" Value="40" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <Style x:Key="SubtitleTextBlockStyle" TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
        <Setter Property="FontFamily" Value="Bahnschrift" />
        <Setter Property="FontStretch" Value="SemiCondensed" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="17" />
        <Setter Property="CharacterSpacing" Value="30" />
    </Style>

    <Style x:Key="InstLabelStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Bahnschrift" />
        <Setter Property="FontStretch" Value="SemiCondensed" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="CharacterSpacing" Value="120" />
        <Setter Property="Foreground" Value="#FF5A6878" />
    </Style>

    <Style x:Key="InstValueStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="#FF0F1D2B" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="InstOutlineButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="#FF0F1D2B" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="2" />
        <Setter Property="Padding" Value="12,9" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="CharacterSpacing" Value="80" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>
</ResourceDictionary>

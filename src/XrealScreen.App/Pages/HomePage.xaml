<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="XrealScreen.App.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:XrealScreen.App.Controls">

    <ScrollViewer>
        <StackPanel Padding="24,16,24,24" Spacing="16" MaxWidth="1100" HorizontalAlignment="Stretch">
            <TextBlock Style="{StaticResource PageTitleStyle}" Text="Workspace" />

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Workspace in the glasses" />
                    <InfoBar
                        IsClosable="False"
                        IsOpen="{x:Bind Session.IsDriverMissing, Mode=OneWay}"
                        Message="Workspaces need the XrealScreen virtual display driver, which is installed separately (the Store cannot install drivers). Head look on the Games page works without it."
                        Severity="Warning"
                        Title="Virtual display driver not installed">
                        <InfoBar.ActionButton>
                            <HyperlinkButton Content="Get the driver" NavigateUri="{x:Bind Session.DriverDownloadUri}" />
                        </InfoBar.ActionButton>
                    </InfoBar>
                    <InfoBar
                        IsClosable="False"
                        IsOpen="True"
                        Message="{x:Bind Session.StatusMessage, Mode=OneWay}"
                        Severity="{x:Bind Session.Severity, Mode=OneWay}"
                        Title="{x:Bind Session.StatusTitle, Mode=OneWay}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button AutomationProperties.Name="Start workspace" Command="{x:Bind Session.StartCommand}" Style="{StaticResource AccentButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="14" Glyph="&#xE768;" />
                                <TextBlock Text="Start workspace" />
                            </StackPanel>
                        </Button>
                        <Button AutomationProperties.Name="Stop workspace" Command="{x:Bind Session.StopCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="14" Glyph="&#xE71A;" />
                                <TextBlock Text="Stop" />
                            </StackPanel>
                        </Button>
                        <Button AutomationProperties.Name="Recenter workspace" Command="{x:Bind Session.RecenterCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="14" Glyph="&#xE7AD;" />
                                <TextBlock Text="Recenter" />
                            </StackPanel>
                        </Button>
                        <Button
                            AutomationProperties.Name="Screenshot of the glasses"
                            Command="{x:Bind Session.TakeScreenshotCommand}"
                            ToolTipService.ToolTip="Save what the glasses show to Pictures\XrealScreen (Ctrl+Alt+P)">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="14" Glyph="&#xE722;" />
                                <TextBlock Text="Screenshot" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8" Visibility="{x:Bind Session.HasScreenshot, Mode=OneWay}">
                        <TextBlock
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind Session.LastScreenshotPath, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis" />
                        <HyperlinkButton Command="{x:Bind Session.OpenScreenshotFolderCommand}" Content="Open folder" />
                    </StackPanel>
                    <Expander Header="Log" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                        <ScrollViewer MaxHeight="200">
                            <ItemsControl ItemsSource="{x:Bind Session.Log}" />
                        </ScrollViewer>
                    </Expander>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Saved workspaces" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap"
                        Text="Your settings are saved automatically. Save them under a name to switch between setups; loading one restarts a running workspace." />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ComboBox
                            MinWidth="240"
                            AutomationProperties.Name="Saved workspace"
                            ItemsSource="{x:Bind Session.SavedWorkspaces}"
                            PlaceholderText="No workspace selected"
                            SelectedItem="{x:Bind Session.SelectedWorkspace, Mode=TwoWay}" />
                        <Button Command="{x:Bind Session.LoadWorkspaceCommand}" Content="Load" Style="{StaticResource AccentButtonStyle}" />
                        <Button AutomationProperties.Name="Delete saved workspace" Command="{x:Bind Session.DeleteWorkspaceCommand}">
                            <FontIcon FontSize="14" Glyph="&#xE74D;" />
                        </Button>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBox
                            MinWidth="240"
                            AutomationProperties.Name="Workspace name"
                            MaxLength="60"
                            PlaceholderText="Name, e.g. Desk"
                            Text="{x:Bind Session.WorkspaceName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Command="{x:Bind Session.SaveWorkspaceCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="14" Glyph="&#xE74E;" />
                                <TextBlock Text="Save current settings" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Click="Import_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="14" Glyph="&#xE8B5;" />
                                <TextBlock Text="Import…" />
                            </StackPanel>
                        </Button>
                        <Button Click="Export_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="14" Glyph="&#xEDE1;" />
                                <TextBlock Text="Export…" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="320" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Layout preview" />
                    <controls:WorkspacePreview Grid.Row="1" />
                    <TextBlock Grid.Row="2" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind Workspace.Summary, Mode=OneWay}" TextWrapping="Wrap" />
                </Grid>
            </Border>

            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Head-tracking preview" />
                        <TextBlock Text="{x:Bind Tracking.Status, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Command="{x:Bind Tracking.StartCommand}" Content="Start" Style="{StaticResource AccentButtonStyle}" />
                            <Button Command="{x:Bind Tracking.StopCommand}" Content="Stop" />
                            <Button AutomationProperties.Name="Recenter preview" Command="{x:Bind Tracking.RecenterCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon FontSize="14" Glyph="&#xE7AD;" />
                                    <TextBlock Text="Recenter" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Glasses" />
                        <TextBlock Text="{x:Bind Device.StatusTitle, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Button Command="{x:Bind Device.CheckCommand}" Content="Check connection" />
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>

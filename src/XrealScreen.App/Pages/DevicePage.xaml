<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="XrealScreen.App.Pages.DevicePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Padding="24,16,24,24" Spacing="16" MaxWidth="1100">
            <TextBlock Style="{StaticResource PageTitleStyle}" Text="Device" />

            <InfoBar
                IsClosable="False"
                IsOpen="True"
                Message="{x:Bind Device.StatusMessage, Mode=OneWay}"
                Severity="{x:Bind Device.Severity, Mode=OneWay}"
                Title="{x:Bind Device.StatusTitle, Mode=OneWay}" />

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock TextWrapping="Wrap" Text="Connect with glasses checks the picture, the USB network, every port, the firmware, and a short head-tracking sample. Send setup switches the glasses picture to the mode this workspace uses: 3840×1080 for glasses anchor, or a normal picture for head tracking. Anchor and Follow stay on the glasses' X button." />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button AutomationProperties.Name="Connect with glasses" Command="{x:Bind Device.CheckCommand}" Content="Connect with glasses" Style="{StaticResource AccentButtonStyle}" />
                        <Button AutomationProperties.Name="Send setup to glasses" Command="{x:Bind Device.SendSetupCommand}" Content="Send setup to glasses" />
                    </StackPanel>
                    <ItemsControl ItemsSource="{x:Bind Device.Results}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>

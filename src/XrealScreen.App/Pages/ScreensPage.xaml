<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="XrealScreen.App.Pages.ScreensPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:XrealScreen.App.Controls">

    <ScrollViewer>
        <StackPanel Padding="24,16,24,24" Spacing="16" MaxWidth="1100">
            <TextBlock Style="{StaticResource PageTitleStyle}" Text="Screens" />

            <Border Style="{StaticResource CardStyle}">
                <RadioButtons
                    Header="Workspace type"
                    ItemsSource="{x:Bind Workspace.KindNames}"
                    SelectedIndex="{x:Bind Workspace.KindIndex, Mode=TwoWay}" />
            </Border>

            <InfoBar
                IsClosable="False"
                IsOpen="{x:Bind Workspace.IsGlassesAnchor, Mode=OneWay}"
                Severity="Informational"
                Title="Glasses anchor"
                Message="{x:Bind Workspace.GlassesSignal, Mode=OneWay}">
                <InfoBar.ActionButton>
                    <Button Click="RefreshSignal_Click" Content="Check again" />
                </InfoBar.ActionButton>
            </InfoBar>

            <Border Style="{StaticResource CardStyle}" Visibility="{x:Bind Workspace.IsAppTracking, Mode=OneWay}">
                <Grid>
                    <controls:WorkspacePreview x:Name="TrackingPreview" Height="280" />
                    <!--  Stage look: StageView goes here (ScreensPage.UseStageView)  -->
                    <Grid x:Name="TrackingStageHost" Visibility="Collapsed" />
                </Grid>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="16">
                    <RadioButtons
                        Visibility="{x:Bind Workspace.IsAppTracking, Mode=OneWay}"
                        Header="Ultrawide mode (virtual screen size)"
                        ItemsSource="{x:Bind Workspace.UltrawideModeNames}"
                        MaxColumns="4"
                        SelectedIndex="{x:Bind Workspace.UltrawideModeIndex, Mode=TwoWay}" />

                    <StackPanel Spacing="12" Visibility="{x:Bind Workspace.IsGlassesAnchor, Mode=OneWay}">
                        <controls:AnchorPreview x:Name="AnchorLayoutPreview" Height="200" />
                        <Grid x:Name="AnchorStageHost" Visibility="Collapsed" />
                        <controls:GradientFrameSettings />
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Slider
                                Header="Space between screens"
                                MinWidth="320"
                                Maximum="200"
                                Minimum="0"
                                StepFrequency="2"
                                Value="{x:Bind Workspace.AnchorGapPixels, Mode=TwoWay}" />
                            <TextBlock
                                Margin="0,24,0,0"
                                VerticalAlignment="Center"
                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                Text="{x:Bind Workspace.AnchorGapText, Mode=OneWay}" />
                        </StackPanel>
                        <RadioButtons
                            Header="Screen shape (screens fill the space and keep this aspect ratio)"
                            ItemsSource="{x:Bind Workspace.AnchorAspectNames}"
                            MaxColumns="3"
                            SelectedIndex="{x:Bind Workspace.AnchorAspectIndex, Mode=TwoWay}" />
                    </StackPanel>
                    <RadioButtons
                        Header="Screens"
                        MaxColumns="3"
                        SelectedIndex="{x:Bind Workspace.ScreenCountIndex, Mode=TwoWay}"
                        Visibility="{x:Bind Workspace.IsGlassesAnchor, Mode=OneWay}">
                        <x:String>1 screen</x:String>
                        <x:String>2 screens</x:String>
                        <x:String>3 screens</x:String>
                    </RadioButtons>
                    <controls:DeskActions />
                    <NumberBox
                        x:Name="ScreenCountBox"
                        Header="Number of screens"
                        Maximum="{x:Bind Workspace.MaxScreenCount, Mode=OneWay}"
                        Minimum="1"
                        SpinButtonPlacementMode="Inline"
                        HorizontalAlignment="Left"
                        MinWidth="200"
                        Value="{x:Bind Workspace.ScreenCount, Mode=TwoWay}"
                        Visibility="{x:Bind Workspace.IsAppTracking, Mode=OneWay}" />

                    <StackPanel Orientation="Horizontal" Spacing="12" Visibility="{x:Bind Workspace.IsGlassesAnchor, Mode=OneWay}">
                        <Button
                            AutomationProperties.Name="Apply screen settings"
                            Command="{x:Bind Session.ApplyScreenSettingsCommand}"
                            Content="Apply screen settings"
                            Style="{StaticResource AccentButtonStyle}" />
                        <TextBlock
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource SystemFillColorCautionBrush}"
                            Text="Changes not applied yet"
                            Visibility="{x:Bind Workspace.HasPendingScreenChanges, Mode=OneWay}" />
                    </StackPanel>

                    <ComboBox
                        Header="Primary monitor while the workspace runs (taskbar, new windows) — numbers as in the preview"
                        MinWidth="280"
                        ItemsSource="{x:Bind Workspace.PrimaryScreenNames, Mode=OneWay}"
                        SelectedIndex="{x:Bind Workspace.PrimaryScreenIndex, Mode=TwoWay}" />

                    <ToggleSwitch
                        Header="Move windows from the glasses display to the workspace when it starts"
                        IsOn="{x:Bind Workspace.MoveWindowsFromGlasses, Mode=TwoWay}" />
                    <TextBlock
                        Margin="0,-8,0,0"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap"
                        Text="Windows go to the primary screen above (screen 1 when the primary monitor is kept). Both take effect at the next start. Windows of apps running as administrator cannot be moved." />

                    <ComboBox
                        Header="Layout"
                        MinWidth="200"
                        ItemsSource="{x:Bind Workspace.PresetNames}"
                        SelectedIndex="{x:Bind Workspace.PresetIndex, Mode=TwoWay}" />
                    <TextBlock
                        Margin="0,-8,0,0"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap"
                        Text="Four or more screens sit in a grid, three across, with the next row below. The desktop monitors follow that grid, so the mouse matches the glasses. Arc keeps every screen in one row." />

                    <Slider
                        Header="Viewing distance (m) — also live while running, or Ctrl+Alt+Plus/Minus"
                        MaxWidth="480"
                        HorizontalAlignment="Left"
                        MinWidth="320"
                        Maximum="4"
                        Minimum="0.8"
                        StepFrequency="0.1"
                        Value="{x:Bind Workspace.DistanceMeters, Mode=TwoWay}" />

                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind Workspace.Summary, Mode=OneWay}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>

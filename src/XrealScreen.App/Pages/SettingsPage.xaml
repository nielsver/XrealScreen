<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="XrealScreen.App.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Padding="24,16,24,24" Spacing="16" MaxWidth="1100">
            <TextBlock Style="{StaticResource PageTitleStyle}" Text="Settings" />

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Background" />
                    <ToggleSwitch
                        x:Name="StartWithWindowsToggle"
                        Header="Start XrealScreen when you sign in to Windows (starts in the tray)"
                        Toggled="StartWithWindows_Toggled" />
                    <TextBlock
                        x:Name="StartupHint"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap"
                        Visibility="Collapsed" />
                    <ComboBox
                        x:Name="AutoStartWorkspaceBox"
                        Header="Workspace to start automatically"
                        MinWidth="280"
                        SelectionChanged="AutoStartWorkspace_SelectionChanged" />
                    <ToggleSwitch
                        x:Name="StartWorkspaceToggle"
                        Header="Start it when XrealScreen starts"
                        Toggled="StartWorkspace_Toggled" />
                    <ToggleSwitch
                        x:Name="GlassesConnectToggle"
                        Header="Start it when the glasses are connected"
                        Toggled="GlassesConnect_Toggled" />
                    <TextBlock
                        Margin="0,-8,0,0"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap"
                        Text="Save workspaces on the Home page to choose them here. &quot;Latest settings&quot; uses whatever you used last. For the glasses, XrealScreen must be running (for example in the tray)." />
                    <ToggleSwitch
                        x:Name="TrayToggle"
                        Header="Keep running in the tray when the window is closed"
                        Toggled="Tray_Toggled" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap"
                        Text="Tray icon: left-click opens XrealScreen, right-click for Start / Stop / Recenter / Exit. Ctrl+Alt+W starts or stops the workspace from anywhere. Exit (bottom of the menu) quits for real." />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap"
                        Text="All settings are saved automatically and loaded when XrealScreen starts. Save, load, export and import workspaces on the Home page." />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Developers" />
                    <ToggleSwitch
                        x:Name="LocalApiToggle"
                        Header="Let programs on this PC control XrealScreen (local API)"
                        Toggled="LocalApi_Toggled" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap"
                        Text="Programs you run can read the head pose, start and stop workspaces and head look, and take screenshots through the named pipe \.\pipe\XrealScreen.Api (JSON-RPC). Only your Windows account can connect; web pages cannot. See docs/sdk in the XrealScreen repository." />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <RadioButtons x:Name="ThemeRadio" Header="App theme" SelectionChanged="ThemeRadio_SelectionChanged">
                    <x:String>Use system setting</x:String>
                    <x:String>Light</x:String>
                    <x:String>Dark</x:String>
                </RadioButtons>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>

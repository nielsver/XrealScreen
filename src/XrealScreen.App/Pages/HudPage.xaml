<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="XrealScreen.App.Pages.HudPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Padding="24,16,24,24" Spacing="16" MaxWidth="1100">
            <TextBlock Style="{StaticResource PageTitleStyle}" Text="HUD" />

            <InfoBar
                IsClosable="True"
                IsOpen="True"
                Severity="Informational"
                Title="Main monitor"
                Message="The glasses show your main monitor live, with the flight marks and a Grok suggestion on top. The mouse keeps working on that monitor. On the glasses: UltraWide Off, screen mode Follow, Stabilizer off. A workspace cannot run at the same time." />

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Command="{x:Bind Hud.StartCommand}" Content="Start HUD" Style="{StaticResource AccentButtonStyle}" />
                        <Button Command="{x:Bind Hud.StopCommand}" Content="Stop" />
                        <Button Command="{x:Bind Hud.RecenterCommand}" Content="Recenter" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind Hud.Status, Mode=OneWay}" TextWrapping="Wrap" />
                    <TextBlock Text="{x:Bind Hud.Pose, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    <TextBlock Text="{x:Bind Hud.HeadLookNote, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap">
                        Heading zero is where you last recentered, not magnetic north. Ctrl+Alt+U starts or stops. Ctrl+Alt+R recenters. Ctrl+Alt+Q stops.
                    </TextBlock>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Overlay" />
                    <Slider
                        Header="Brightness"
                        Maximum="1"
                        Minimum="0.15"
                        StepFrequency="0.05"
                        Value="{x:Bind Hud.Brightness, Mode=TwoWay}" />
                    <ToggleSwitch Header="Horizon" IsOn="{x:Bind Hud.ShowHorizon, Mode=TwoWay}" />
                    <ToggleSwitch Header="Pitch ladder" IsOn="{x:Bind Hud.ShowLadder, Mode=TwoWay}" />
                    <ToggleSwitch Header="Heading tape" IsOn="{x:Bind Hud.ShowTape, Mode=TwoWay}" />
                    <ToggleSwitch Header="Clock" IsOn="{x:Bind Hud.ShowClock, Mode=TwoWay}" />
                    <ToggleSwitch Header="Drawings" IsOn="{x:Bind Hud.ShowMarkers, Mode=TwoWay}" />
                    <ToggleSwitch Header="Look actions" IsOn="{x:Bind Hud.ShowGlance, Mode=TwoWay}" />
                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Text="The main monitor is live in the glasses, and the mouse keeps working on that monitor. Grok looks at that picture and puts a short suggestion on it. The suggestion stays until the next one. Look at READ and hold still to ask again now. Up shows what you copied. Left starts a 25 minute timer. Right plays or pauses. Down mutes. The marks stay in the room when you turn your head." />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Images" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Click="AddImages_Click" Content="Add images" Style="{StaticResource AccentButtonStyle}" />
                        <Button Click="RemoveImage_Click" Content="Remove" />
                    </StackPanel>
                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Text="Pick pictures and drag them on the frame. They show in the glasses at that spot, on top of the monitor. The mouse wheel changes the size of the selected image. Your monitor mouse keeps working." />
                    <TextBlock Foreground="{ThemeResource SystemFillColorCriticalBrush}" Text="{x:Bind Hud.ImageNote, Mode=OneWay}" TextWrapping="Wrap" />
                    <Border
                        x:Name="ImageBoard"
                        Height="220"
                        HorizontalAlignment="Stretch"
                        Background="#FF061016"
                        CornerRadius="6"
                        PointerCanceled="Board_Released"
                        PointerCaptureLost="Board_Released"
                        PointerMoved="Board_Moved"
                        PointerPressed="Board_Pressed"
                        PointerReleased="Board_Released"
                        PointerWheelChanged="Board_Wheel">
                        <Grid>
                            <TextBlock
                                x:Name="ImageBoardEmpty"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                IsHitTestVisible="False"
                                Text="No images yet." />
                            <Canvas x:Name="ImageCanvas" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" IsHitTestVisible="False" />
                        </Grid>
                    </Border>
                    <Slider
                        Header="Size of the selected image"
                        Maximum="1.6"
                        Minimum="0.15"
                        StepFrequency="0.02"
                        Value="{x:Bind Hud.SelectedImageSize, Mode=TwoWay}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>

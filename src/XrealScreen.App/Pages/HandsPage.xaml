<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="XrealScreen.App.Pages.HandsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Padding="24,16,24,24" Spacing="16" MaxWidth="1100">
            <TextBlock Style="{StaticResource PageTitleStyle}" Text="Hands" />

            <InfoBar
                IsClosable="False"
                IsOpen="True"
                Severity="Informational"
                Title="XREAL Eye"
                Message="Needs the Eye camera on the glasses. Turn Gesture Control off in the glasses menu, or the glasses react to the same pinch. The pointer moves on the glasses monitor. Ctrl+Alt+J starts or stops. Stopping closes the camera." />

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Command="{x:Bind Hands.StartCommand}" Content="Start hand control" Style="{StaticResource AccentButtonStyle}" />
                        <Button Command="{x:Bind Hands.StopCommand}" Content="Stop" />
                    </StackPanel>
                    <ComboBox Header="Click" SelectedIndex="{x:Bind Hands.ClickModeIndex, Mode=TwoWay}">
                        <x:String>Pinch</x:String>
                        <x:String>Hold still</x:String>
                        <x:String>Pinch or hold still</x:String>
                    </ComboBox>
                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind Hands.Status, Mode=OneWay}" TextWrapping="Wrap" />
                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind Hands.Detail, Mode=OneWay}" TextWrapping="Wrap" />
                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind Hands.CameraNote, Mode=OneWay}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="8">
                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Calibration" />
                    <TextBlock TextWrapping="Wrap" Text="The first fit is the default mapping. A closer fit is saved by xrs hands targets --calibrate and picked up here when the error is small enough. That command also runs the 40 px target check." />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>

<?xml version="1.0" encoding="utf-8" ?>
<!--  Lens look Home: one round Start control with the lens sheen, live head readouts, layout and saved workspaces.  -->
<Page
    x:Class="XrealScreen.App.Pages.Looks.LensHomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:XrealScreen.App.Controls"
    xmlns:looks="using:XrealScreen.App.Looks"
    Background="Transparent">

    <Page.Resources>
        <Style x:Key="ReadoutStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource LensWellBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LensLineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="MinWidth" Value="104" />
        </Style>
        <Style x:Key="ReadoutLabelStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource LookMonoFontFamily}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="CharacterSpacing" Value="120" />
            <Setter Property="Foreground" Value="{StaticResource LensMutedBrush}" />
        </Style>
        <Style x:Key="ReadoutValueStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource LookMonoFontFamily}" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="Foreground" Value="{StaticResource LensTextBrush}" />
        </Style>
    </Page.Resources>

    <ScrollViewer>
        <Grid Padding="32,24,32,32" RowSpacing="22" MaxWidth="1200">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <InfoBar
                IsClosable="False"
                IsOpen="{x:Bind Session.IsDriverMissing, Mode=OneWay}"
                Message="Workspaces need the XrealScreen virtual display driver. Head look on the Games page works without it."
                Severity="Warning"
                Title="Virtual display driver not installed">
                <InfoBar.ActionButton>
                    <HyperlinkButton Content="Get the driver" NavigateUri="{x:Bind Session.DriverDownloadUri}" />
                </InfoBar.ActionButton>
            </InfoBar>

            <!--  Hero: Start ring + status + live readouts  -->
            <Border
                Grid.Row="1"
                Padding="28,26"
                Background="{StaticResource LensHeroBrush}"
                BorderBrush="{StaticResource LensLineBrush}"
                BorderThickness="1"
                CornerRadius="20">
                <Grid ColumnSpacing="36">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Grid Width="232" Height="232">
                        <Ellipse Fill="{StaticResource LensGlowBrush}" />
                        <Button
                            Width="188"
                            Height="188"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="Start or stop the workspace"
                            Click="StartStop_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Grid x:Name="Root">
                                        <VisualStateManager.VisualStateGroups>
                                            <VisualStateGroup x:Name="CommonStates">
                                                <VisualState x:Name="Normal" />
                                                <VisualState x:Name="PointerOver">
                                                    <VisualState.Setters>
                                                        <Setter Target="Inner.Opacity" Value="0.86" />
                                                        <Setter Target="Ring.Margin" Value="-3" />
                                                    </VisualState.Setters>
                                                </VisualState>
                                                <VisualState x:Name="Pressed">
                                                    <VisualState.Setters>
                                                        <Setter Target="Inner.Opacity" Value="0.7" />
                                                    </VisualState.Setters>
                                                </VisualState>
                                                <VisualState x:Name="Disabled">
                                                    <VisualState.Setters>
                                                        <Setter Target="Root.Opacity" Value="0.45" />
                                                    </VisualState.Setters>
                                                </VisualState>
                                            </VisualStateGroup>
                                        </VisualStateManager.VisualStateGroups>
                                        <Ellipse x:Name="Ring" Fill="{StaticResource LensSheenBrush}" />
                                        <Ellipse x:Name="Inner" Margin="3" Fill="{StaticResource LensRingInnerBrush}" />
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Grid>
                                </ControlTemplate>
                            </Button.Template>
                            <StackPanel Spacing="6">
                                <FontIcon
                                    HorizontalAlignment="Center"
                                    FontSize="24"
                                    Foreground="{StaticResource LensTextBrush}"
                                    Glyph="{x:Bind looks:LookFormat.StartGlyph(Session.State), Mode=OneWay}" />
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    FontFamily="{StaticResource LookDisplayFontFamily}"
                                    FontSize="28"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource LensTextBrush}"
                                    Text="{x:Bind looks:LookFormat.StartLabel(Session.State), Mode=OneWay}" />
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    FontSize="12"
                                    Foreground="{StaticResource LensMutedBrush}"
                                    Text="{x:Bind looks:LookFormat.ScreensText(Workspace.ScreenCount, Workspace.KindIndex), Mode=OneWay}" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="6">
                        <TextBlock
                            FontFamily="{StaticResource LookDisplayFontFamily}"
                            FontSize="32"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource LensTextBrush}"
                            Text="{x:Bind Session.StatusTitle, Mode=OneWay}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            MaxWidth="620"
                            HorizontalAlignment="Left"
                            FontSize="14"
                            Foreground="{StaticResource LensMutedBrush}"
                            Text="{x:Bind Session.StatusMessage, Mode=OneWay}"
                            TextWrapping="Wrap" />

                        <StackPanel Margin="0,14,0,0" Orientation="Horizontal" Spacing="10">
                            <Border Style="{StaticResource ReadoutStyle}">
                                <StackPanel Spacing="2">
                                    <TextBlock Style="{StaticResource ReadoutLabelStyle}" Text="YAW" />
                                    <TextBlock Style="{StaticResource ReadoutValueStyle}" Text="{x:Bind looks:LookFormat.Degrees(Tracking.Yaw), Mode=OneWay}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource ReadoutStyle}">
                                <StackPanel Spacing="2">
                                    <TextBlock Style="{StaticResource ReadoutLabelStyle}" Text="PITCH" />
                                    <TextBlock Style="{StaticResource ReadoutValueStyle}" Text="{x:Bind looks:LookFormat.Degrees(Tracking.Pitch), Mode=OneWay}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource ReadoutStyle}">
                                <StackPanel Spacing="2">
                                    <TextBlock Style="{StaticResource ReadoutLabelStyle}" Text="ROLL" />
                                    <TextBlock Style="{StaticResource ReadoutValueStyle}" Text="{x:Bind looks:LookFormat.Degrees(Tracking.Roll), Mode=OneWay}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource ReadoutStyle}">
                                <StackPanel Spacing="2">
                                    <TextBlock Style="{StaticResource ReadoutLabelStyle}" Text="GLASSES" />
                                    <TextBlock
                                        MaxWidth="220"
                                        FontSize="15"
                                        Margin="0,3,0,0"
                                        Foreground="{StaticResource LensTextBrush}"
                                        Text="{x:Bind Device.StatusTitle, Mode=OneWay}"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel Margin="0,12,0,0" Orientation="Horizontal" Spacing="8">
                            <Button Command="{x:Bind Session.RecenterCommand}" Style="{StaticResource LensPillButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon FontSize="14" Glyph="&#xE7AD;" />
                                    <TextBlock Text="Recenter" />
                                </StackPanel>
                            </Button>
                            <Button
                                Command="{x:Bind Session.TakeScreenshotCommand}"
                                Style="{StaticResource LensPillButtonStyle}"
                                ToolTipService.ToolTip="Save what the glasses show to Pictures\XrealScreen (Ctrl+Alt+P)">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon FontSize="14" Glyph="&#xE722;" />
                                    <TextBlock Text="Screenshot" />
                                </StackPanel>
                            </Button>
                            <Button
                                Command="{x:Bind Tracking.StartCommand}"
                                Style="{StaticResource LensPillButtonStyle}"
                                ToolTipService.ToolTip="Show live yaw, pitch and roll without starting the workspace">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon FontSize="14" Glyph="&#xE7B3;" />
                                    <TextBlock Text="Preview tracking" />
                                </StackPanel>
                            </Button>
                            <Button AutomationProperties.Name="Connect with glasses" Command="{x:Bind Device.CheckCommand}" Style="{StaticResource LensPillButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon FontSize="14" Glyph="&#xE703;" />
                                    <TextBlock Text="Connect" />
                                </StackPanel>
                            </Button>
                            <Button AutomationProperties.Name="Send setup to glasses" Command="{x:Bind Device.SendSetupCommand}" Style="{StaticResource LensPillButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon FontSize="14" Glyph="&#xE898;" />
                                    <TextBlock Text="Send setup" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!--  Layout + saved workspaces  -->
            <Grid Grid.Row="2" ColumnSpacing="22">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.6*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource CardStyle}">
                    <Grid RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Foreground="{StaticResource LensTextBrush}" Text="Layout" />
                            <TextBlock
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                FontFamily="{StaticResource LookMonoFontFamily}"
                                FontSize="12"
                                Foreground="{StaticResource LensMutedBrush}"
                                Text="{x:Bind looks:LookFormat.ScreensText(Workspace.ScreenCount, Workspace.KindIndex), Mode=OneWay}" />
                        </Grid>
                        <controls:AnchorPreview Grid.Row="1" Height="220" Visibility="{x:Bind Workspace.IsGlassesAnchor, Mode=OneWay}" />
                        <controls:WorkspacePreview Grid.Row="1" Height="260" Visibility="{x:Bind Workspace.IsAppTracking, Mode=OneWay}" />
                        <TextBlock
                            Grid.Row="2"
                            FontSize="12"
                            Foreground="{StaticResource LensMutedBrush}"
                            Text="{x:Bind Workspace.GlassesSignal, Mode=OneWay}"
                            TextWrapping="Wrap"
                            Visibility="{x:Bind Workspace.IsGlassesAnchor, Mode=OneWay}" />
                    </Grid>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                    <Grid RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Foreground="{StaticResource LensTextBrush}" Text="Saved workspaces" />
                            <TextBlock
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                FontFamily="{StaticResource LookMonoFontFamily}"
                                FontSize="12"
                                Foreground="{StaticResource LensMutedBrush}"
                                Text="auto-saved" />
                        </Grid>
                        <TextBlock
                            Grid.Row="1"
                            FontSize="13"
                            Foreground="{StaticResource LensMutedBrush}"
                            Text="No saved workspaces yet. Name the current settings below and save them to switch between setups."
                            TextWrapping="Wrap"
                            Visibility="{x:Bind looks:LookFormat.ShowIfEmpty(Session.SavedWorkspaces.Count), Mode=OneWay}" />
                        <ListView
                            Grid.Row="1"
                            MinHeight="120"
                            MaxHeight="220"
                            ItemsSource="{x:Bind Session.SavedWorkspaces}"
                            SelectedItem="{x:Bind Session.SelectedWorkspace, Mode=TwoWay}"
                            SelectionMode="Single">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <TextBlock Padding="0,8" FontSize="14" Text="{x:Bind}" />
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
                            <Button Command="{x:Bind Session.LoadWorkspaceCommand}" Content="Load" Style="{StaticResource AccentButtonStyle}" CornerRadius="18" Padding="16,8" />
                            <Button AutomationProperties.Name="Delete saved workspace" Command="{x:Bind Session.DeleteWorkspaceCommand}" Style="{StaticResource LensPillButtonStyle}">
                                <FontIcon FontSize="14" Glyph="&#xE74D;" />
                            </Button>
                            <Button AutomationProperties.Name="Import or export" Style="{StaticResource LensPillButtonStyle}">
                                <FontIcon FontSize="14" Glyph="&#xE712;" />
                                <Button.Flyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem Click="Import_Click" Text="Import…" />
                                        <MenuFlyoutItem Click="Export_Click" Text="Export…" />
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>
                        </StackPanel>
                        <Grid Grid.Row="3" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox
                                AutomationProperties.Name="Workspace name"
                                MaxLength="60"
                                PlaceholderText="Save current as…"
                                Text="{x:Bind Session.WorkspaceName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Grid.Column="1" AutomationProperties.Name="Save current settings" Command="{x:Bind Session.SaveWorkspaceCommand}" Style="{StaticResource LensPillButtonStyle}">
                                <FontIcon FontSize="14" Glyph="&#xE74E;" />
                            </Button>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <Expander
                Grid.Row="3"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                Header="Log">
                <ScrollViewer MaxHeight="200">
                    <ItemsControl FontFamily="{StaticResource LookMonoFontFamily}" FontSize="12" ItemsSource="{x:Bind Session.Log}" />
                </ScrollViewer>
            </Expander>
        </Grid>
    </ScrollViewer>
</Page>

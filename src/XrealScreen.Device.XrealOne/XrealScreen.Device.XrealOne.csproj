<Project Sdk="Microsoft.NET.Sdk">
  <!-- NuGet dependency of XrealScreen.Sdk (ADR-0012). Public API documented where it is SDK-facing. -->
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>XrealScreen.Device.XrealOne</PackageId>
    <Description>IMU stream of XREAL One / One Pro / 1S glasses over their USB network adapter. Used by XrealScreen.Sdk.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
  </PropertyGroup>
  <!-- XREAL One-series (One, One Pro, 1S) transport over the USB network adapter. -->
  <ItemGroup>
    <ProjectReference Include="..\XrealScreen.Core\XrealScreen.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="XrealScreen.Device.Tests" />
  </ItemGroup>
</Project>

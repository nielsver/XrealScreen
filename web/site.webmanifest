{
  "name": "XrealScreen",
  "short_name": "XrealScreen",
  "description": "Virtual monitors for XREAL glasses on Windows 11.",
  "start_url": "/",
  "display": "browser",
  "background_color": "#0a0f17",
  "theme_color": "#0a0f17",
  "icons": [
    { "src": "/assets/img/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/assets/img/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "/assets/img/icon.svg", "sizes": "any", "type": "image/svg+xml" }
  ]
}
